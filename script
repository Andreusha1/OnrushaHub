			TextTruncate = Enum.TextTruncate.AtEnd, AutomaticSize = Enum.AutomaticSize.None,
		}, parent)
		ctx.Theme:Bind(label, { TextColor3 = token or "Text" })
		return label
	end

	local function play(ctx, instance, info, goal)
		if not ctx.Settings.AnimationsEnabled or ctx.Settings.ReducedMotion then
			for key, value in pairs(goal) do instance[key] = value end
			return nil
		end
		ctx._activeTweens = ctx._activeTweens or {}
		local previous = ctx._activeTweens[instance]
		if previous then pcall(function() previous:Cancel() end) end
		local tween = TweenService:Create(instance, TweenInfo.new((info or 0.16) / math.max(0.2, ctx.Settings.AnimationSpeed or 1), Enum.EasingStyle.Quart, Enum.EasingDirection.Out), goal)
		ctx._activeTweens[instance] = tween
		tween.Completed:Connect(function() if ctx._activeTweens[instance] == tween then ctx._activeTweens[instance] = nil end end)
		tween:Play()
		return tween
	end

	local function relativeLuminance(color)
		local function channel(value)
			return value <= 0.04045 and value / 12.92 or ((value + 0.055) / 1.055) ^ 2.4
		end
		return 0.2126 * channel(color.R) + 0.7152 * channel(color.G) + 0.0722 * channel(color.B)
	end
	local function contrastRatio(first, second)
		local a, b = relativeLuminance(first), relativeLuminance(second)
		if a < b then a, b = b, a end
		return (a + 0.05) / (b + 0.05)
	end
	local function keybindSurface(palette, hovered)
		local surface = palette.Hover:Lerp(palette.Accent, hovered and 0.42 or 0.34)
		if relativeLuminance(palette.Background) < 0.45 then
			surface = surface:Lerp(palette.Text, hovered and 0.30 or 0.25)
		else
			surface = surface:Lerp(palette.Background, hovered and 0.18 or 0.14)
		end
		return surface
	end
	local function readableTextColor(surface, palette)
		if relativeLuminance(palette.Background) < 0.5 then
			return Color3.fromRGB(255, 255, 255)
		end
		return palette.Text
	end
	local function switchKnobColor(palette, enabled)
		if not enabled then return palette.Text end
		return contrastRatio(palette.Accent, palette.Background) >= contrastRatio(palette.Accent, palette.Text) and palette.Background or palette.Text
	end

	local function getLayoutOrder(ctx)
		ctx._componentCount += 1
		return ctx._componentCount
	end

	local function normalizeOptions(options)
		if type(options) == "string" then return { Name = options } end
		return type(options) == "table" and options or {}
	end

	local function pointInside(guiObject, point)
		if not guiObject or not guiObject.Parent or not guiObject.Visible then return false end
		local position, size = guiObject.AbsolutePosition, guiObject.AbsoluteSize
		return point.X >= position.X and point.X <= position.X + size.X and point.Y >= position.Y and point.Y <= position.Y + size.Y
	end

	local function registerPopup(ctx, component, popup, trigger, closePopup)
		ctx._popupRecords = ctx._popupRecords or {}
		local record = { Popup = popup, Trigger = trigger, Close = closePopup }
		table.insert(ctx._popupRecords, record)
		if not ctx._popupConnection then
			ctx._popupConnection = UserInputService.InputBegan:Connect(function(input)
				if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then return end
				local point = Vector2.new(input.Position.X, input.Position.Y)
				for index = #ctx._popupRecords, 1, -1 do
					local item = ctx._popupRecords[index]
					if not item.Popup or not item.Popup.Parent then
						table.remove(ctx._popupRecords, index)
					elseif item.Popup.Visible and not pointInside(item.Popup, point) and not pointInside(item.Trigger, point) then
						item.Close()
					end
				end
			end)
			ctx._cleanup:Add(function()
				if ctx._popupConnection then ctx._popupConnection:Disconnect(); ctx._popupConnection = nil end
				table.clear(ctx._popupRecords)
			end)
		end
		component._maid:Add(function()
			for index = #ctx._popupRecords, 1, -1 do if ctx._popupRecords[index] == record then table.remove(ctx._popupRecords, index); break end end
		end)
	end

	local function createComponent(parent, ctx, kind, rawOptions, scope)
