		end
		function component:Set(value, silent)
			if self._destroyed then return self end
			local old = self._value
			local nextValue = value
			if kind == "Toggle" or kind == "Checkbox" then
				nextValue = value == true
			elseif kind == "Slider" or kind == "NumberInput" or kind == "Progress" then
				local min = tonumber(options.Min) or 0
				local max = tonumber(options.Max) or 100
				nextValue = math.clamp(tonumber(value) or tonumber(options.Default) or min, min, max)
				local step = tonumber(options.Step) or (kind == "Slider" and 1 or 0)
				if step > 0 then nextValue = min + math.floor(((nextValue - min) / step) + 0.5) * step end
				if step >= 1 then nextValue = math.floor(nextValue + 0.5) else nextValue = math.floor(nextValue * 1000 + 0.5) / 1000 end
				nextValue = math.clamp(nextValue, min, max)
			elseif kind == "SliderToggle" then
				if type(value) == "table" then
					nextValue = { Enabled = value.Enabled == true, Value = math.clamp(tonumber(value.Value) or tonumber(options.DefaultValue) or tonumber(options.Min) or 0, tonumber(options.Min) or 0, tonumber(options.Max) or 100) }
				else
					nextValue = self._value or { Enabled = false, Value = tonumber(options.DefaultValue) or tonumber(options.Min) or 0 }
					nextValue.Enabled = value == true
				end
			elseif kind == "Dropdown" or kind == "RadioGroup" then
				local valid = false
				for _, option in ipairs(options.Options or {}) do if option == value then valid = true; break end end
				nextValue = valid and value or (options.Options and options.Options[1] or nil)
			elseif kind == "MultiDropdown" or kind == "MultiToggle" then
				local selected = {}
				if type(value) == "table" then
					for key, item in pairs(value) do
						if item == true then
							for _, option in ipairs(options.Options or {}) do if key == option then selected[key] = true end end
						else
							for _, option in ipairs(options.Options or {}) do if item == option then selected[item] = true end end
						end
					end
				end
				nextValue = selected
			elseif kind == "ColorPicker" or kind == "ColorGradient" then
				nextValue = typeof(value) == "Color3" and value or options.Default or Color3.fromRGB(255, 135, 75)
			elseif kind == "Input" then
				nextValue = tostring(value == nil and "" or value)
				if #nextValue > (tonumber(options.MaxLength) or 256) then nextValue = string.sub(nextValue, 1, tonumber(options.MaxLength) or 256) end
			elseif kind == "Keybind" or kind == "Hotkey" or kind == "Bind" then
				nextValue = typeof(value) == "EnumItem" and value.EnumType == Enum.KeyCode and value or Enum.KeyCode.Unknown
