        local image = make("ImageLabel", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, 0), ScaleType = Enum.ScaleType.Fit, Image = tostring(options.Image or options.AssetId or "") }, top)
        right.Visible = false
        component.Image = image
