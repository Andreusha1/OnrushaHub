            renderBrightness(brightness, hue, saturation, brightness)
            local channels = { math.floor(value.R * 255 + 0.5), math.floor(value.G * 255 + 0.5), math.floor(value.B * 255 + 0.5) }
            for index, box in ipairs(rgbBoxes) do if not box:IsFocused() then box.Text = tostring(channels[index]) end end
        end
        component._maid:Add(colorButton.Activated:Connect(function()
            local opening = not popup.Visible
            if opening then
                popup.Visible = true
                positionColorStudio()
                popup.Size = UDim2.fromOffset(220, 0)
                play(ctx, popup, 0.2, { Size = UDim2.fromOffset(220, 242) })
            else
                play(ctx, popup, 0.16, { Size = UDim2.fromOffset(220, 0) })
                task.delay(0.17, function() if popup.Parent and popup.Size.Y.Offset == 0 then popup.Visible = false end end)
            end
        end))
        component._controlButton = colorButton
        component:Set(options.Default or Color3.fromRGB(255, 135, 75), true)
    elseif kind == "Keybind" or kind == "Hotkey" or kind == "Bind" then
        right.Size = UDim2.fromOffset(98, 30)
        local button = makeSmallButton("Set key", UDim2.fromScale(1, 1))
        local listening = false
        component._render = function(value) button.Text = value == Enum.KeyCode.Unknown and "None" or value.Name end
        component._maid:Add(button.Activated:Connect(function() listening = true; button.Text = "Press key..."; ctx._listeningKeybind = component end))
        component._setListening = function(value) listening = value == true end
        component._onKey = function(key)
            if listening then listening = false; ctx._listeningKeybind = nil; component:Set(key); return true end
            if component:Get() == key and not component._disabled then
                local mode = tostring(options.Mode or "Toggle")
                if mode == "Hold" then component._held = true; component._clickSignal:Fire(true, key)
                elseif mode == "Toggle" then component._pressed = not component._pressed; component._clickSignal:Fire(component._pressed, key)
                else component._clickSignal:Fire(true, key) end
            end
            return false
        end
        component._controlButton = button
        component:Set(options.Default or Enum.KeyCode.Unknown, true)
    elseif kind == "RadioGroup" then
        right.Visible = false
        local listY = description ~= "" and (25 + descriptionHeight) or 27
        local list = make("Frame", { BackgroundTransparency = 1, Position = UDim2.new(0, 0, 0, listY), Size = UDim2.new(1, 0, 0, math.min(4, #(options.Options or {})) * 27) }, top)
        local listLayout = make("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 4) }, list)
        local buttons = {}
        for index, option in ipairs(options.Options or {}) do
            local optionButton = make("TextButton", { Text = tostring(option), Font = Enum.Font.GothamMedium, TextSize = 12, Size = UDim2.new(1 / math.max(1, #options.Options), -4, 0, 26), BorderSizePixel = 0, LayoutOrder = index, AutoButtonColor = false }, list)
            ctx.Theme:Bind(optionButton, { BackgroundColor3 = function(theme) return component:Get() == option and theme.Accent or theme.Hover end, TextColor3 = "Text" }); corner(optionButton, 5)
            optionButton.Activated:Connect(function() component:Set(option) end)
            table.insert(buttons, optionButton)
        end
        component._render = function(value) for _, button in ipairs(buttons) do button.BackgroundColor3 = value and button.Text == tostring(value) and ctx.Theme:Get().Accent or ctx.Theme:Get().Hover end end
        component:Set(options.Default, true)
    elseif kind == "MultiToggle" then
        right.Visible = false
        local listY = description ~= "" and (25 + descriptionHeight) or 27
        local list = make("Frame", { BackgroundTransparency = 1, Position = UDim2.new(0, 0, 0, listY), Size = UDim2.new(1, 0, 0, math.min(4, #(options.Options or {})) * 27) }, top)
        local listLayout = make("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 4) }, list)
        for index, option in ipairs(options.Options or {}) do
            local optionButton = make("TextButton", { Text = tostring(option), Font = Enum.Font.GothamMedium, TextSize = 11, Size = UDim2.new(1 / math.max(1, #options.Options), -4, 0, 26), BorderSizePixel = 0, LayoutOrder = index, AutoButtonColor = false }, list)
            ctx.Theme:Bind(optionButton, { BackgroundColor3 = "Hover", TextColor3 = "Text" }); corner(optionButton, 5)
            optionButton.Activated:Connect(function()
                local value = table.clone(component:Get() or {})
                value[option] = not value[option]
                local values = {}; for _, item in ipairs(options.Options) do if value[item] then table.insert(values, item) end end
                component:Set(values)
            end)
        end
        component._render = function(value) for _, button in ipairs(list:GetChildren()) do if button:IsA("TextButton") then button.BackgroundColor3 = value and value[button.Text] and ctx.Theme:Get().Accent or ctx.Theme:Get().Hover end end end
        component:Set(options.Default or {}, true)
    elseif kind == "RangeSlider" then
        right.Visible = false
        local rangeInputY = description ~= "" and (25 + descriptionHeight + 3) or 27
        local first, second = make("TextBox", { Size = UDim2.new(0.45, 0, 0, 24), Position = UDim2.new(0, 0, 0, rangeInputY), Text = "", ClearTextOnFocus = false, Font = Enum.Font.GothamMedium, TextSize = 12, BorderSizePixel = 0 }, top), nil
        second = make("TextBox", { Size = UDim2.new(0.45, 0, 0, 24), Position = UDim2.new(0.55, 0, 0, rangeInputY), Text = "", ClearTextOnFocus = false, Font = Enum.Font.GothamMedium, TextSize = 12, BorderSizePixel = 0 }, top)
        for _, box in ipairs({ first, second }) do ctx.Theme:Bind(box, { BackgroundColor3 = "Hover", TextColor3 = "Text" }); corner(box, 5); make("UIPadding", { PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 5) }, box) end
        component._render = function(value) first.Text = tostring(value.Min); second.Text = tostring(value.Max) end
        local function applyRange() component:Set({ Min = tonumber(first.Text) or component:Get().Min, Max = tonumber(second.Text) or component:Get().Max }) end
        component._maid:Add(first.FocusLost:Connect(applyRange)); component._maid:Add(second.FocusLost:Connect(applyRange))
        component:Set({ Min = options.DefaultMin or options.Min or 0, Max = options.DefaultMax or options.Max or 100 }, true)
    elseif kind == "Search" then
        right.Size = UDim2.fromOffset(124, 28)
        local box = make("TextBox", { Size = UDim2.fromScale(1, 1), Text = "", PlaceholderText = "Search...", ClearTextOnFocus = false, Font = Enum.Font.GothamMedium, TextSize = 12, BorderSizePixel = 0, TextXAlignment = Enum.TextXAlignment.Left }, right)
        ctx.Theme:Bind(box, { BackgroundColor3 = "Hover", TextColor3 = "Text", PlaceholderColor3 = "SecondaryText" }); corner(box, 6)
        make("UIPadding", { PaddingLeft = UDim.new(0, 8) }, box)
        component._render = function(value) box.Text = tostring(value or "") end
        component._maid:Add(box:GetPropertyChangedSignal("Text"):Connect(function() component:Set(box.Text); if options.Callback then options.Callback(box.Text) end end))
        component:Set("", true)
    elseif kind == "Accordion" then
        right.Size = UDim2.fromOffset(44, 27)
        local button = makeSmallButton("Open", UDim2.fromScale(1, 1))
        local expanded = false
        component._maid:Add(button.Activated:Connect(function() expanded = not expanded; if component._settingsPanel then component._settingsPanel.Visible = expanded end; button.Text = expanded and "Close" or "Open" end))
    elseif kind == "Custom" then
        right.Visible = false
        local builder = options.Build or (Controls.CustomBuilders and Controls.CustomBuilders[options.ComponentType or options.Name])
        if type(builder) == "function" then
            local ok, result = pcall(builder, top, options, { Theme = ctx.Theme, UI = ctx.UI, Component = component })
            if not ok then warn("[Onrusha] Custom component builder failed:", result) elseif typeof(result) == "Instance" then component._maid:Add(result) end
        end
    else
        right.Visible = false
    end

    if kind == "Paragraph" or kind == "Image" then component.DescriptionLabel = nil end
    component:SetDescriptionVisible(ctx.Settings.ShowDescriptions ~= false)
    ctx._components[id] = component
    table.insert(scope._components, component)
    if component._triggerKey and ctx.RefreshKeybinds then ctx:RefreshKeybinds() end
    if ctx._tabByName and scope._name then component._tabName = scope._tab and scope._tab.Name or scope._tabName or scope._name end
    if ctx._searchQuery and ctx._searchQuery ~= "" then
        local query = string.lower(ctx._searchQuery)
        card.Visible = string.find(string.lower(name .. " " .. description .. " " .. tostring(component._tabName or "")), query, 1, true) ~= nil
    end
    if component._settingsPanel then component._settingsPanel.LayoutOrder = 2 end
    return component
end

function Controls.Attach(target, ctx, resolveParent)
    target._components = target._components or {}
    local function add(kind, first, second)
        local options = first == target and second or first
        local parent = resolveParent and resolveParent() or target._parent
        assert(parent and parent.Parent, "Onrusha component parent is no longer available")
        return createComponent(parent, ctx, kind, options, target)
    end
    local names = {
        ToggleCreate = "Toggle", SliderCreate = "Slider", SliderToggleCreate = "SliderToggle", DropdownCreate = "Dropdown",
        MultiDropdownCreate = "MultiDropdown", ButtonCreate = "Button", KeybindCreate = "Keybind", HotkeyCreate = "Hotkey", BindCreate = "Bind",
        ColorPickerCreate = "ColorPicker", ColorGradientCreate = "ColorGradient", InputCreate = "Input", NumberInputCreate = "NumberInput",
        SearchCreate = "Search", LabelCreate = "Label", ParagraphCreate = "Paragraph", DividerCreate = "Divider", CheckboxCreate = "Checkbox",
        RadioGroupCreate = "RadioGroup", MultiToggleCreate = "MultiToggle", RangeSliderCreate = "RangeSlider", ProgressCreate = "Progress",
        NotificationCreate = "Notification", ImageCreate = "Image", StatusCreate = "Status", AccordionCreate = "Accordion", SubTabCreate = "RadioGroup", KeybindListCreate = "KeybindList", SpacerCreate = "Spacer", CustomCreate = "Custom",
    }
    for methodName, kind in pairs(names) do
        target[methodName] = function(first, second) return add(kind, first, second) end
    end
    return target
end

return Controls
end

-- ===== INTERNAL MODULE: init =====
__onrusha_modules["init"] = function()
local Window = __require("Core/Window")

local Onrusha = {
    Name = "Onrusha",
    Version = "1.5.0",
}

function Onrusha.Create(first, second)
    local options
    if first == Onrusha then options = second else options = first end
    return Window.new(options or {})
end

Onrusha.new = Onrusha.Create

return Onrusha
end

-- Public entry point: returns the Onrusha API table.
return __require("init")
