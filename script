        valueText.FontFace = Font.new("rbxasset://fonts/families/SourceSansPro.json", Enum.FontWeight.Bold)
        valueText.TextScaled = true
        valueText.Text = tostring(default)
        valueText.Parent = bar

        local item = setmetatable({
            Type = "Slider", Card = card, Title = title,
            Bar = bar, Fill = fill, ValueText = valueText,
            Min = min, Max = max,
            Integer = options.Integer ~= false,
            Value = default,
        }, Slider)

        local dragging = false
        bar.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                item:_fromX(input.Position.X)
            end
        end)

        UserInputService.InputChanged:Connect(function(input)
            if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                item:_fromX(input.Position.X)
            end
        end)

        UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = false
            end
        end)

