Button.__index = Button

function Button:_set(value)
	self.Value = value
end

local Textbox = setmetatable({}, Item)
Textbox.__index = Textbox

function Textbox:_set(value, updateOnly)
	self.Value = tostring(value or "")
	self.Box.Text = self.Value
	if not updateOnly then
		safeCall(self.Callback, self.Value)
	end
end

function Textbox:SetValue(value, silent)
	self:_set(value, silent)
	return self
end

local Dropdown = setmetatable({}, Item)
Dropdown.__index = Dropdown

function Dropdown:_set(value, updateOnly)
	self.Value = value
	self.Current.Text = tostring(value)
	if not updateOnly then
		safeCall(self.Callback, value)
	end
end

function Dropdown:SetValue(value, silent)
	self:_set(value, silent)
	return self
end

function Dropdown:Refresh(values)
	self.Values = values or {}
	self.Index = 1
	self:_set(self.Values[1] or "", true)
	return self
end

function Dropdown:Next()
	if #self.Values == 0 then
		return self
	end
	self.Index = self.Index % #self.Values + 1
	self:_set(self.Values[self.Index], false)
	return self
end

function Dropdown:Previous()
	if #self.Values == 0 then
		return self
	end
	self.Index = (self.Index - 2) % #self.Values + 1
	self:_set(self.Values[self.Index], false)
	return self
end

