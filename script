local function make(className, props, parent)
    local instance = Instance.new(className)
    for key, value in pairs(props or {}) do instance[key] = value end
    instance.Parent = parent
    return instance
end

local function corner(parent, radius)
    return make("UICorner", { CornerRadius = UDim.new(0, radius or 7) }, parent)
end

local function stroke(parent, ctx, token)
    local obj = make("UIStroke", { Thickness = 1, Transparency = 0.18 }, parent)
    ctx.Theme:Bind(obj, { Color = token or "Border" })
    return obj
end

local function textLabel(parent, ctx, text, size, token, bold)
    local label = make("TextLabel", {
        BackgroundTransparency = 1, Text = text or "", Font = bold and Enum.Font.GothamBold or Enum.Font.GothamMedium,
        TextSize = size or 13, TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Center,
        TextTruncate = Enum.TextTruncate.AtEnd, AutomaticSize = Enum.AutomaticSize.None,
    }, parent)
    ctx.Theme:Bind(label, { TextColor3 = token or "Text" })
    return label
end

local function play(ctx, instance, info, goal)
    if not ctx.Settings.AnimationsEnabled or ctx.Settings.ReducedMotion then
        for key, value in pairs(goal) do instance[key] = value end
        return nil
    end
    ctx._activeTweens = ctx._activeTweens or {}
    local previous = ctx._activeTweens[instance]
    if previous then pcall(function() previous:Cancel() end) end
    local tween = TweenService:Create(instance, TweenInfo.new((info or 0.16) / math.max(0.2, ctx.Settings.AnimationSpeed or 1), Enum.EasingStyle.Quart, Enum.EasingDirection.Out), goal)
    ctx._activeTweens[instance] = tween
    tween.Completed:Connect(function() if ctx._activeTweens[instance] == tween then ctx._activeTweens[instance] = nil end end)
    tween:Play()
    return tween
end

local function getLayoutOrder(ctx)
    ctx._componentCount += 1
    return ctx._componentCount
end

local function normalizeOptions(options)
    if type(options) == "string" then return { Name = options } end
    return type(options) == "table" and options or {}
end

local function pointInside(guiObject, point)
    if not guiObject or not guiObject.Parent or not guiObject.Visible then return false end
    local position, size = guiObject.AbsolutePosition, guiObject.AbsoluteSize
    return point.X >= position.X and point.X <= position.X + size.X and point.Y >= position.Y and point.Y <= position.Y + size.Y
end

local function registerPopup(ctx, component, popup, trigger, closePopup)
    ctx._popupRecords = ctx._popupRecords or {}
    local record = { Popup = popup, Trigger = trigger, Close = closePopup }
    table.insert(ctx._popupRecords, record)
    if not ctx._popupConnection then
        ctx._popupConnection = UserInputService.InputBegan:Connect(function(input)
            if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then return end
            local point = Vector2.new(input.Position.X, input.Position.Y)
            for index = #ctx._popupRecords, 1, -1 do
                local item = ctx._popupRecords[index]
                if not item.Popup or not item.Popup.Parent then
                    table.remove(ctx._popupRecords, index)
                elseif item.Popup.Visible and not pointInside(item.Popup, point) and not pointInside(item.Trigger, point) then
                    item.Close()
                end
            end
        end)
        ctx._cleanup:Add(function()
            if ctx._popupConnection then ctx._popupConnection:Disconnect(); ctx._popupConnection = nil end
            table.clear(ctx._popupRecords)
        end)
    end
    component._maid:Add(function()
        for index = #ctx._popupRecords, 1, -1 do if ctx._popupRecords[index] == record then table.remove(ctx._popupRecords, index); break end end
    end)
end

local function createComponent(parent, ctx, kind, rawOptions, scope)
    local options = normalizeOptions(rawOptions)
    local name = tostring(options.Name or kind)
    local description = tostring(options.Description or "")
    local order = getLayoutOrder(ctx)
    local id = tostring(options.Id or (tostring(scope._name or "Main") .. "/" .. name .. "#" .. tostring(order)))
    if ctx._components[id] then
        local base, suffix = id, 2
        while ctx._components[id] do id = base .. "_" .. suffix; suffix += 1 end
        warn("[Onrusha] Duplicate component Id; assigned " .. id)
    end

    local card = make("Frame", {
        Name = "Component_" .. id:gsub("[^%w_%-]", "_"), BackgroundTransparency = 0,
        BorderSizePixel = 0, Size = UDim2.new(1, 0, 0, 1), AutomaticSize = Enum.AutomaticSize.Y,
        LayoutOrder = order, ClipsDescendants = false,
    }, parent)
    ctx.Theme:Bind(card, { BackgroundColor3 = "Card" })
    corner(card, ctx.Settings.CompactMode and 6 or 8)
    local cardStroke = stroke(card, ctx)
    make("UIPadding", { PaddingTop = UDim.new(0, 8), PaddingBottom = UDim.new(0, 8), PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10) }, card)
    make("UIListLayout", { FillDirection = Enum.FillDirection.Vertical, SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 5) }, card)

    local isVisualOnly = kind == "Divider" or kind == "Spacer" or kind == "Image" or kind == "Paragraph" or kind == "Label" or kind == "Progress" or kind == "Status" or kind == "KeybindList"
    local descriptionLines = description == "" and 0 or math.clamp(math.ceil(#description / 32), 1, 3)
    local descriptionHeight = descriptionLines * 16
    local topHeight = description ~= "" and (34 + descriptionHeight) or 31
    if kind == "Slider" or kind == "SliderToggle" then topHeight = description ~= "" and (53 + descriptionHeight) or 55 end
    if kind == "RangeSlider" then topHeight = description ~= "" and (53 + descriptionHeight) or 58 end
    if kind == "RadioGroup" or kind == "MultiToggle" then topHeight = (description ~= "" and (28 + descriptionHeight) or 27) + math.min(4, #(options.Options or {})) * 29 end
    if kind == "Paragraph" then topHeight = math.max(38, 24 + math.ceil(#(options.Text or description) / 32) * 16) end
    if kind == "Divider" then topHeight = 10 end
    if kind == "Spacer" then topHeight = math.clamp(tonumber(options.Size) or 8, 0, 80) end
    if kind == "Image" then topHeight = math.clamp(tonumber(options.Height) or 84, 36, 220) end
    if kind == "Progress" then topHeight = description ~= "" and (44 + descriptionHeight) or 47 end
    if kind == "Status" then topHeight = description ~= "" and (34 + descriptionHeight) or 31 end
    if kind == "KeybindList" then topHeight = math.max(34, math.min(8, #ctx._keybinds) * 18 + 22) end
    if kind == "Input" and options.MultiLine then topHeight = description ~= "" and (76 + descriptionHeight) or 82 end

    local top = make("Frame", { Name = "Row", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, topHeight), LayoutOrder = 1 }, card)
    local reserves = { Toggle = 50, Checkbox = 36, Button = 114, Notification = 114, Dropdown = 130, MultiDropdown = 130, Input = 130, NumberInput = 130, Search = 130, ColorPicker = 78, ColorGradient = 78, Keybind = 106, Hotkey = 106, Bind = 106, Status = 134, Progress = 44, Slider = 88, SliderToggle = 90, RangeSlider = 4, RadioGroup = 4, MultiToggle = 4, Label = 4, Paragraph = 4, KeybindList = 4, Image = 4, Divider = 4, Spacer = 4 }
    local titleReserve = reserves[kind] or 116
    local title = textLabel(top, ctx, name, 14, "Text", true)
    title.Position = UDim2.fromOffset(0, 0)
    title.Size = UDim2.new(1, -titleReserve, 0, 20)
    local descriptionLabel
    if description ~= "" then
        local desc = textLabel(top, ctx, description, 12, "SecondaryText", false)
        descriptionLabel = desc
        desc.TextWrapped = true
        desc.TextTruncate = Enum.TextTruncate.None
        desc.TextYAlignment = Enum.TextYAlignment.Top
        local descriptionBelowControl = kind ~= "Slider" and kind ~= "RangeSlider" and kind ~= "SliderToggle" and kind ~= "RadioGroup" and kind ~= "MultiToggle" and kind ~= "Progress" and not (kind == "Input" and options.MultiLine)
        desc.Position = UDim2.fromOffset(0, descriptionBelowControl and 32 or 22)
        desc.Size = UDim2.new(1, -4, 0, descriptionHeight)
    end

    local component = {
        Id = id, Name = name, Description = description, Type = kind, Frame = card, Row = top,
        _ctx = ctx, _scope = scope, _callbacks = Signal.new(), _clickSignal = Signal.new(),
        _value = nil, _destroyed = false, _configurable = options.Configurable ~= false,
        _options = options, _maid = ctx.Cleanup.new(), _layoutOrder = order,
        DescriptionLabel = descriptionLabel, _descriptionHeight = descriptionHeight, _baseTopHeight = topHeight,
    }
    component.Title = title
    function component:SetDescriptionVisible(visible)
        if not self.DescriptionLabel then return self end
        visible = visible == true
        self.DescriptionLabel.Visible = visible
        local height = self._baseTopHeight - (visible and 0 or self._descriptionHeight)
        local target = UDim2.new(1, 0, 0, math.max(20, height))
        play(ctx, top, 0.2, { Size = target })
        return self
    end
    card.Active = true
    component._maid:Add(card.MouseEnter:Connect(function()
        if ctx._mobile then return end
        if ctx.PlaySound then ctx.PlaySound("Hover") end
        play(ctx, card, 0.14, { BackgroundColor3 = ctx.Theme:Get().Hover })
        play(ctx, cardStroke, 0.14, { Color = ctx.Theme:Get().Accent, Transparency = 0.12 })
    end))
    component._maid:Add(card.MouseLeave:Connect(function()
        play(ctx, card, 0.16, { BackgroundColor3 = ctx.Theme:Get().Card })
        play(ctx, cardStroke, 0.16, { Color = ctx.Theme:Get().Border, Transparency = 0.18 })
    end))

    function component:Get() return self._value end
    function component:OnChanged(callback)
        self._callbacks:Connect(callback)
        return self
    end
    function component:OnClick(callback)
        self._clickSignal:Connect(callback)
        return self
    end
    function component:SetVisible(visible)
        if self.Frame then self.Frame.Visible = visible == true end
        if not visible and self._popup then self._popup.Visible = false end
        return self
    end
    function component:SetDisabled(disabled)
        self._disabled = disabled == true
        if self._controlButton and self._controlButton:IsA("GuiObject") then
            self._controlButton.Active = not self._disabled
            self._controlButton.AutoButtonColor = not self._disabled
            self._controlButton.BackgroundTransparency = self._disabled and 0.48 or 0
        end
        if self.Title then self.Title.TextTransparency = self._disabled and 0.45 or 0 end
        return self
    end
    function component:Destroy()
        if self._destroyed then return end
        self._destroyed = true
        self._maid:Destroy()
        self._callbacks:Destroy()
        self._clickSignal:Destroy()
        ctx._components[self.Id] = nil
        if ctx._listeningKeybind == self then ctx._listeningKeybind = nil end
        if self._triggerKey and ctx.RefreshKeybinds then ctx:RefreshKeybinds() end
        if self.Frame then self.Frame:Destroy() end
    end
    function component:Set(value, silent)
        if self._destroyed then return self end
        local old = self._value
        local nextValue = value
        if kind == "Toggle" or kind == "Checkbox" then
            nextValue = value == true
        elseif kind == "Slider" or kind == "NumberInput" or kind == "Progress" then
            local min = tonumber(options.Min) or 0
            local max = tonumber(options.Max) or 100
            nextValue = math.clamp(tonumber(value) or tonumber(options.Default) or min, min, max)
            local step = tonumber(options.Step) or (kind == "Slider" and 1 or 0)
            if step > 0 then nextValue = min + math.floor(((nextValue - min) / step) + 0.5) * step end
            if step >= 1 then nextValue = math.floor(nextValue + 0.5) else nextValue = math.floor(nextValue * 1000 + 0.5) / 1000 end
            nextValue = math.clamp(nextValue, min, max)
        elseif kind == "SliderToggle" then
            if type(value) == "table" then
                nextValue = { Enabled = value.Enabled == true, Value = math.clamp(tonumber(value.Value) or tonumber(options.DefaultValue) or tonumber(options.Min) or 0, tonumber(options.Min) or 0, tonumber(options.Max) or 100) }
            else
                nextValue = self._value or { Enabled = false, Value = tonumber(options.DefaultValue) or tonumber(options.Min) or 0 }
                nextValue.Enabled = value == true
            end
        elseif kind == "Dropdown" or kind == "RadioGroup" then
            local valid = false
            for _, option in ipairs(options.Options or {}) do if option == value then valid = true; break end end
            nextValue = valid and value or (options.Options and options.Options[1] or nil)
        elseif kind == "MultiDropdown" or kind == "MultiToggle" then
            local selected = {}
            if type(value) == "table" then
                for key, item in pairs(value) do
                    if item == true then
                        for _, option in ipairs(options.Options or {}) do if key == option then selected[key] = true end end
                    else
                        for _, option in ipairs(options.Options or {}) do if item == option then selected[item] = true end end
                    end
                end
            end
            nextValue = selected
        elseif kind == "ColorPicker" or kind == "ColorGradient" then
            nextValue = typeof(value) == "Color3" and value or options.Default or Color3.fromRGB(255, 135, 75)
        elseif kind == "Input" then
            nextValue = tostring(value == nil and "" or value)
            if #nextValue > (tonumber(options.MaxLength) or 256) then nextValue = string.sub(nextValue, 1, tonumber(options.MaxLength) or 256) end
        elseif kind == "Keybind" or kind == "Hotkey" or kind == "Bind" then
            nextValue = typeof(value) == "EnumItem" and value.EnumType == Enum.KeyCode and value or Enum.KeyCode.Unknown
            self._triggerKey = nextValue
            ctx:RefreshKeybinds()
        elseif kind == "RangeSlider" then
            local min, max = tonumber(options.Min) or 0, tonumber(options.Max) or 100
            local a = type(value) == "table" and tonumber(value.Min) or tonumber(options.DefaultMin) or min
            local b = type(value) == "table" and tonumber(value.Max) or tonumber(options.DefaultMax) or max
            a, b = math.clamp(a or min, min, max), math.clamp(b or max, min, max)
            if a > b then a, b = b, a end
            nextValue = { Min = a, Max = b }
        elseif kind == "Status" then
            nextValue = tostring(value or "Idle")
        else
            nextValue = value
        end
        self._value = nextValue
        if self._render then pcall(self._render, nextValue) end
        if not silent and old ~= nextValue then
            if kind == "SliderToggle" then self._callbacks:Fire(nextValue.Enabled, nextValue.Value) else self._callbacks:Fire(nextValue) end
        end
        return self
    end
    function component:CreateSettings(settingsOptions)
        if self._settingsScope then return self._settingsScope end
        settingsOptions = normalizeOptions(settingsOptions)
        local panel = make("Frame", { Name = "NestedSettings", BackgroundTransparency = 0, BorderSizePixel = 0, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.None, ClipsDescendants = true, Visible = false, LayoutOrder = 2 }, card)
        ctx.Theme:Bind(panel, { BackgroundColor3 = "Sidebar" })
        corner(panel, 7)
        local panelPadding = make("UIPadding", { PaddingTop = UDim.new(0, 8), PaddingBottom = UDim.new(0, 8), PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8) }, panel)
        local layout = make("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }, panel)
        local function updatePanelSize()
            local targetHeight = layout.AbsoluteContentSize.Y + panelPadding.PaddingTop.Offset + panelPadding.PaddingBottom.Offset
            if panel.Visible then play(ctx, panel, 0.2, { Size = UDim2.new(1, 0, 0, targetHeight) }) end
        end
        local layoutConnection = layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(updatePanelSize)
        self._maid:Add(layoutConnection)
        local nested = { _ctx = ctx, _name = self.Name .. "/Settings", _parent = panel, _components = {} }
        Controls.Attach(nested, ctx, function() return panel end)
        self._settingsPanel = panel
        self._settingsScope = nested
        if not self._settingsButton then
            self._settingsButton = make("TextButton", { Name = "SettingsButton", BackgroundTransparency = 1, Text = "v", Font = Enum.Font.GothamMedium, TextSize = 15, Size = UDim2.fromOffset(20, 24), Position = UDim2.new(1, -22, 0, 0), Visible = false, AutoButtonColor = false }, self.Row)
            ctx.Theme:Bind(self._settingsButton, { TextColor3 = "SecondaryText" })
        end
        self._settingsButton.Visible = true
        if self._right and self._right.AnchorPoint.X == 1 then self._right.Position = UDim2.new(self._right.Position.X.Scale, self._right.Position.X.Offset - 24, self._right.Position.Y.Scale, self._right.Position.Y.Offset) end
        if self.Title then self.Title.Size = UDim2.new(self.Title.Size.X.Scale, self.Title.Size.X.Offset - 24, self.Title.Size.Y.Scale, self.Title.Size.Y.Offset) end
        self._maid:Add(self._settingsButton.Activated:Connect(function()
            if panel.Visible then
                play(ctx, panel, 0.16, { Size = UDim2.new(1, 0, 0, 0) })
                play(ctx, self._settingsButton, 0.16, { Rotation = 0 })
                task.delay(0.17, function() if panel.Parent and panel.Size.Y.Offset == 0 then panel.Visible = false end end)
            else
                panel.Visible = true
                panel.Size = UDim2.new(1, 0, 0, 0)
                task.defer(updatePanelSize)
                play(ctx, self._settingsButton, 0.16, { Rotation = 180 })
            end
        end) )
        self._maid:Add(function()
            for _, nestedComponent in pairs(nested._components) do if nestedComponent.Destroy then nestedComponent:Destroy() end end
            nested._components = {}
        end)
        return nested
    end

    local rightX = -2
    local controlWidth = 112
    local right = make("Frame", { BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, rightX, 0, 0), Size = UDim2.new(0, controlWidth, 0, 29) }, top)
    component._right = right
    local controlParent = right
