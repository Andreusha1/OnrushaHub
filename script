		local reserves = { Toggle = 50, Checkbox = 36, Button = 114, Notification = 114, Dropdown = 130, MultiDropdown = 130, Input = 130, NumberInput = 130, Search = 130, ColorPicker = 78, ColorGradient = 78, Keybind = 106, Hotkey = 106, Bind = 106, Status = 134, Progress = 44, Slider = 88, SliderToggle = 90, RangeSlider = 4, RadioGroup = 4, MultiToggle = 4, Label = 4, Paragraph = 4, KeybindList = 4, Image = 4, Divider = 4, Spacer = 4 }
