        topHeight = topHeight
        title.Size = UDim2.new(1, -4, 0, 17)
        if description ~= "" then
            for _, child in ipairs(top:GetChildren()) do
                if child:IsA("TextLabel") and child ~= title then child.Size = UDim2.new(1, -4, 0, descriptionHeight); child.Position = UDim2.fromOffset(0, 22) end
            end
        end
    elseif kind == "Divider" or kind == "Spacer" then
        title.Visible = false
        right.Visible = false
        card.BackgroundTransparency = 1
        cardStroke.Enabled = false
        if kind == "Divider" then
