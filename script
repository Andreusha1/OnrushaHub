    if kind == "Toggle" or kind == "Checkbox" then
        right.Size = UDim2.fromOffset(kind == "Checkbox" and 25 or 40, 23)
        local button = make("TextButton", { Name = "Switch", Size = UDim2.fromScale(1, 1), BorderSizePixel = 0, Text = "", AutoButtonColor = false, Active = true, Selectable = true, ZIndex = 5 }, right)
