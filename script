		return self
	end

	function ThemeManager:Get(name)
		return self._themes[name or self._name]
	end

	function ThemeManager:GetName()
		return self._name
	end

	function ThemeManager:Set(name)
		assert(type(name) == "string", "Theme name must be a string")
		local theme = self._themes[name]
		if not theme then
			warn("[Onrusha] Unknown theme '" .. name .. "'; keeping " .. self._name)
			return false
		end
		self._name = name
		self._current = theme
		for i = #self._bindings, 1, -1 do
			local binding = self._bindings[i]
			local instance = binding.Instance
			if not instance or not instance.Parent then
				if binding.Connection then binding.Connection:Disconnect() end
				table.remove(self._bindings, i)
			else
				for property, token in pairs(binding.Properties) do
					local value = type(token) == "function" and token(theme) or theme[token]
					if value ~= nil then pcall(function() instance[property] = value end) end
				end
				applyBindingGradient(self, binding)
			end
		end
		self.Changed:Fire(name, theme)
		return true
	end

	function ThemeManager:Bind(instance, properties)
		local binding = { Instance = instance, Properties = properties }
		table.insert(self._bindings, binding)
		binding.Connection = instance.Destroying:Connect(function()
			for i = #self._bindings, 1, -1 do
				if self._bindings[i] == binding then table.remove(self._bindings, i); break end
			end
			if binding.Connection then binding.Connection:Disconnect() end
		end)
		for property, token in pairs(properties) do
			local value = type(token) == "function" and token(self._current) or self._current[token]
			if value ~= nil then pcall(function() instance[property] = value end) end
		end
		task.defer(function()
			if instance and instance.Parent then applyBindingGradient(self, binding) end
		end)
		return instance
	end

	function ThemeManager:Create(name, colors)
		assert(type(name) == "string" and name ~= "", "Theme name is required")
		assert(type(colors) == "table", "Theme colors must be a table")
		local base = mergeTheme(THEMES.Midnight)
		for key, value in pairs(colors) do
			assert(base[key] ~= nil, "Unknown theme color: " .. tostring(key))
			assert(typeof(value) == "Color3", "Theme color '" .. tostring(key) .. "' must be Color3")
			base[key] = value
		end
		self._themes[name] = base
		return true
	end

	function ThemeManager:Names()
		local names = {}
		for name in pairs(self._themes) do table.insert(names, name) end
		table.sort(names)
		return names
	end

	function ThemeManager:Destroy()
		for _, binding in ipairs(self._bindings) do if binding.Connection then binding.Connection:Disconnect() end end
		table.clear(self._bindings)
		if self.Changed then self.Changed:Destroy() end
	end

	return ThemeManager
