		self.Card:Destroy()
	end
end

function Item:_set(value)
	self.Value = value
end

function Item:_finish(value)
	self.Value = value
	safeCall(self.Callback, value)
end

function Item:Enable()
	return self:SetValue(true)
end

function Item:Disable()
	return self:SetValue(false)
end

local Toggle = setmetatable({}, Item)
Toggle.__index = Toggle

function Toggle:_set(value, updateOnly)
	value = value == true
	self.Value = value
	if self.Button then
		local target = value and UDim2.new(1, -23, 0.5, -10) or UDim2.new(0.58333, -23, 0.5, -10)
		local color = value and Color3.fromRGB(78, 71, 112) or Color3.fromRGB(112, 112, 112)
		tween(self.Button, {BackgroundColor3 = color}, 0.12)
		tween(self.Knob, {Position = target}, 0.12)
	end
	if not updateOnly then
		safeCall(self.Callback, value)
	end
end

function Toggle:SetValue(value, silent)
	self:_set(value, silent)
	return self
end

local Slider = setmetatable({}, Item)
Slider.__index = Slider

function Slider:_set(value, updateOnly)
	value = math.clamp(tonumber(value) or self.Min, self.Min, self.Max)
	value = self.Integer and math.floor(value + 0.5) or value
	self.Value = value
	self.ValueText.Text = tostring(value)

	local percent = math.clamp((value - self.Min) / math.max(self.Max - self.Min, 1), 0, 1)
	tween(self.Fill, {
		Position = UDim2.new(0, 0, 0, 0),
		Size = UDim2.new(percent, 0, 1, 0),
	}, 0.1)

	if not updateOnly then
		safeCall(self.Callback, value)
	end
end

function Slider:SetValue(value, silent)
	self:_set(value, silent)
	return self
end

function Slider:_fromX(x)
	local left = self.Bar.AbsolutePosition.X
	local width = math.max(self.Bar.AbsoluteSize.X, 1)
	local offset = math.clamp(x - left, 0, width)
	local value = self.Min + (self.Max - self.Min) * (offset / width)
	self:_set(value, false)
end

