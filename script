		return true
	end

	function ShaderManager:Set(key, value)
		if self._destroyed or key == "Enabled" then return false, "Invalid shader setting" end
		if NUMBER_RANGES[key] then
			if type(value) ~= "number" then value = tonumber(value) end
			if not value then return false, "Expected a number" end
			value = math.clamp(value, NUMBER_RANGES[key][1], NUMBER_RANGES[key][2])
		elseif BOOLEAN_KEYS[key] then
			value = value == true
		elseif COLOR_KEYS[key] then
			if typeof(value) ~= "Color3" then return false, "Expected a Color3" end
		else
			return false, "Unknown shader setting: " .. tostring(key)
		end
		self.Values[key] = value
		if self.Enabled then self:_sync() else self:_applyValues() end
		return true
	end

	function ShaderManager:Destroy()
		if self._destroyed then return end
		self.Enabled = false
		self:_sync()
		self._destroyed = true
		for _, effect in ipairs({ self.ColorCorrection, self.Bloom, self.SunRays, self.DepthOfField }) do
			if effect then effect:Destroy() end
		end
	end

	return ShaderManager
end

-- ===== INTERNAL MODULE: Core/Signal =====
__onrusha_modules["Core/Signal"] = function()
	local Signal = {}
	Signal.__index = Signal

	function Signal.new()
		return setmetatable({ _listeners = {}, _destroyed = false }, Signal)
	end

	function Signal:Connect(callback)
		assert(type(callback) == "function", "Signal:Connect expects a function")
		assert(not self._destroyed, "Cannot connect to a destroyed signal")
		local record = { Callback = callback, Connected = true }
		table.insert(self._listeners, record)
		local connection = {}
		function connection:Disconnect()
			if not record.Connected then return end
			record.Connected = false
			for i = #self._signal._listeners, 1, -1 do
				if self._signal._listeners[i] == record then
					table.remove(self._signal._listeners, i)
					break
				end
			end
		end
		connection._signal = self
		connection.Destroy = connection.Disconnect
		return connection
	end

	function Signal:Fire(...)
		if self._destroyed then return end
		local args = table.pack(...)
		local listeners = table.clone(self._listeners)
		for _, record in ipairs(listeners) do
			if record.Connected then
				local ok, err = pcall(record.Callback, table.unpack(args, 1, args.n))
				if not ok then warn("[Onrusha] Signal callback failed:", err) end
			end
		end
	end

	function Signal:Destroy()
		if self._destroyed then return end
		self._destroyed = true
		table.clear(self._listeners)
	end

	return Signal
end

