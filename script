			end)

			local secondsLeft = tonumber(expiresIn)
			if secondsLeft and secondsLeft > 0 then
				secondsLeft = math.max(1, math.floor(secondsLeft))
				ctx._keyExpiresAt = os.clock() + secondsLeft
				task.delay(secondsLeft, function()
					if ctx._destroyed or not ctx._keyUnlocked then return end
					ctx._keyUnlocked = false
					ctx._keyExpiresAt = nil
