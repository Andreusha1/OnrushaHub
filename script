				keyStatusStroke.Transparency = 0.6
			end
		end))
		local function updateKeyGateLayout()
			local viewport = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize or Vector2.new(1280, 720)
			local targetScale
			if viewport.Y < 480 and viewport.X >= 600 then
				keyPanel.Size = UDim2.new(0.88, 0, 0, 472)
