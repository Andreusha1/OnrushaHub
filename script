local __onrusha_modules = {}
local __onrusha_cache = {}
local __onrusha_loading = {}

local function __require(name)
    local cached = __onrusha_cache[name]
    if cached ~= nil then return cached end
    local loader = __onrusha_modules[name]
    if type(loader) ~= "function" then error("Onrusha bundle: missing internal module " .. tostring(name), 2) end
    if __onrusha_loading[name] then error("Onrusha bundle: circular module dependency at " .. tostring(name), 2) end
    __onrusha_loading[name] = true
    local ok, result = pcall(loader)
    __onrusha_loading[name] = nil
    if not ok then error(result, 2) end
    if result == nil then result = true end
    __onrusha_cache[name] = result
    return result
end

-- ===== INTERNAL MODULE: Core/Cleanup =====
__onrusha_modules["Core/Cleanup"] = function()
local Cleanup = {}
Cleanup.__index = Cleanup

function Cleanup.new()
    return setmetatable({ _items = {}, _destroyed = false }, Cleanup)
end

function Cleanup:Add(item)
    if item == nil then return item end
    if self._destroyed then
        self:_dispose(item)
    else
        table.insert(self._items, item)
    end
    return item
end

function Cleanup:Remove(item, dispose)
    for i = #self._items, 1, -1 do
        if self._items[i] == item then
            table.remove(self._items, i)
            if dispose then self:_dispose(item) end
            return true
        end
    end
    return false
end

function Cleanup:_dispose(item)
    local kind = typeof(item)
    if kind == "RBXScriptConnection" then
        if item.Connected then item:Disconnect() end
    elseif kind == "Instance" then
        item:Destroy()
    elseif kind == "function" then
        pcall(item)
    elseif type(item) == "table" then
        if type(item.Destroy) == "function" then
            pcall(function() item:Destroy() end)
        elseif type(item.Disconnect) == "function" then
            pcall(function() item:Disconnect() end)
        end
    end
end

function Cleanup:Clean()
    for i = #self._items, 1, -1 do
        self:_dispose(self._items[i])
        self._items[i] = nil
    end
end

function Cleanup:Destroy()
    if self._destroyed then return end
    self:Clean()
    self._destroyed = true
end

return Cleanup
end

-- ===== INTERNAL MODULE: Core/ConfigManager =====
__onrusha_modules["Core/ConfigManager"] = function()
local HttpService = game:GetService("HttpService")
local ConfigManager = {}
ConfigManager.__index = ConfigManager

local function encodeValue(value)
    local kind = typeof(value)
    if kind == "Color3" then
        return { __onrushaType = "Color3", R = value.R, G = value.G, B = value.B }
    elseif kind == "UDim2" then
        return { __onrushaType = "UDim2", XScale = value.X.Scale, XOffset = value.X.Offset, YScale = value.Y.Scale, YOffset = value.Y.Offset }
    elseif kind == "EnumItem" then
        return { __onrushaType = "EnumItem", EnumType = tostring(value.EnumType), Name = value.Name }
    elseif type(value) == "table" then
        local result = {}
        for key, item in pairs(value) do
            if type(key) == "string" or type(key) == "number" then result[key] = encodeValue(item) end
        end
        return result
    elseif type(value) == "string" or type(value) == "number" or type(value) == "boolean" or value == nil then
        return value
    end
    return nil
end

local function decodeValue(value)
    if type(value) ~= "table" then return value end
    if value.__onrushaType == "Color3" then
        if type(value.R) == "number" and type(value.G) == "number" and type(value.B) == "number" then
            return Color3.new(math.clamp(value.R, 0, 1), math.clamp(value.G, 0, 1), math.clamp(value.B, 0, 1))
        end
        return nil
    elseif value.__onrushaType == "UDim2" then
        if type(value.XScale) == "number" and type(value.XOffset) == "number" and type(value.YScale) == "number" and type(value.YOffset) == "number" then
            return UDim2.new(math.clamp(value.XScale, -1, 2), math.clamp(value.XOffset, -2000, 2000), math.clamp(value.YScale, -1, 2), math.clamp(value.YOffset, -2000, 2000))
        end
        return nil
    elseif value.__onrushaType == "EnumItem" and value.EnumType == "Enum.KeyCode" then
        local ok, result = pcall(function() return Enum.KeyCode[value.Name] end)
        if ok then return result end
        return nil
    end
    local result = {}
    for key, item in pairs(value) do result[key] = decodeValue(item) end
    return result
end

function ConfigManager.new(owner)
    return setmetatable({ _owner = owner, _configs = {}, _active = "Default" }, ConfigManager)
end

function ConfigManager:_snapshot()
    local values = {}
    for id, component in pairs(self._owner._components) do
        if component._configurable ~= false and type(component.Get) == "function" then
            local ok, value = pcall(function() return component:Get() end)
            if ok then values[id] = encodeValue(value) end
        end
    end
    return {
        Version = 1,
        Name = self._active,
        Theme = self._owner.Theme:GetName(),
        ThemePalette = encodeValue(self._owner.Theme:Get()),
        Scale = self._owner._ctx._scale,
        Position = encodeValue(self._owner._ctx.WindowFrame and self._owner._ctx.WindowFrame.Position),
        Values = values,
        Settings = encodeValue(self._owner._settings),
    }
end

function ConfigManager:Create(name)
    assert(type(name) == "string" and name:gsub("%s", "") ~= "", "Config name cannot be empty")
    self._configs[name] = self:_snapshot()
    self._configs[name].Name = name
    self._active = name
    return true
end

function ConfigManager:Save(name)
    name = name or self._active
    if not self._configs[name] then return false, "Configuration does not exist" end
    self._configs[name] = self:_snapshot()
    self._configs[name].Name = name
    self._active = name
    return true
end

function ConfigManager:Load(name)
    local config = self._configs[name]
    if not config then return false, "Configuration does not exist" end
    if type(config.Values) == "table" then
        for id, savedValue in pairs(config.Values) do
            local component = self._owner._components[id]
            if component and type(component.Set) == "function" then
                local value = decodeValue(savedValue)
                if value ~= nil then pcall(function() component:Set(value) end) end
            end
        end
    end
    if type(config.Theme) == "string" and type(config.ThemePalette) == "table" then
        local palette = decodeValue(config.ThemePalette)
        if type(palette) == "table" then pcall(function() self._owner:CreateTheme(config.Theme, palette) end) end
    end
    if config.Theme then self._owner:SetTheme(config.Theme) end
    if type(config.Scale) == "number" then self._owner:SetScale(config.Scale) end
    local position = decodeValue(config.Position)
    if typeof(position) == "UDim2" then self._owner:SetPosition(position) end
    local settings = decodeValue(config.Settings)
    if type(settings) == "table" then
        for key, value in pairs(settings) do self._owner._settings[key] = value end
    end
    self._active = name
    return true
end

function ConfigManager:Rename(oldName, newName)
    if not self._configs[oldName] then return false, "Configuration does not exist" end
    if type(newName) ~= "string" or newName:gsub("%s", "") == "" then return false, "New name cannot be empty" end
    if self._configs[newName] then return false, "A configuration with that name already exists" end
    self._configs[newName] = self._configs[oldName]
    self._configs[newName].Name = newName
    self._configs[oldName] = nil
    if self._active == oldName then self._active = newName end
    return true
end

function ConfigManager:Duplicate(name, copyName)
    if not self._configs[name] then return false, "Configuration does not exist" end
    if self._configs[copyName] then return false, "A configuration with that name already exists" end
    local encoded = HttpService:JSONEncode(self._configs[name])
    self._configs[copyName] = HttpService:JSONDecode(encoded)
    self._configs[copyName].Name = copyName
    return true
end

function ConfigManager:Delete(name)
    if not self._configs[name] then return false, "Configuration does not exist" end
    self._configs[name] = nil
    if self._active == name then self._active = "Default" end
    return true
end

function ConfigManager:List()
    local result = {}
    for name in pairs(self._configs) do table.insert(result, name) end
    table.sort(result)
    return result
end

function ConfigManager:Export(name)
    name = name or self._active
    local config
    if name == self._active then
        config = self:_snapshot()
        config.Name = name
        self._configs[name] = config
    else
        config = self._configs[name] or self:_snapshot()
        config.Name = name
    end
    local ok, result = pcall(function() return HttpService:JSONEncode(config) end)
    if not ok then return nil, "Could not encode configuration: " .. tostring(result) end
    return result
end

function ConfigManager:Import(json, name)
    if type(json) ~= "string" or #json > 1024 * 512 then return false, "Configuration text is empty or too large" end
    local ok, decoded = pcall(function() return HttpService:JSONDecode(json) end)
    if not ok or type(decoded) ~= "table" or type(decoded.Values) ~= "table" then
        return false, "Invalid Onrusha configuration JSON"
    end
    name = name or decoded.Name or "Imported"
    if type(name) ~= "string" or name:gsub("%s", "") == "" then return false, "Invalid configuration name" end
    decoded.Name = name
    self._configs[name] = decoded
    return self:Load(name)
end

function ConfigManager:GetActive()
    return self._active
end

return ConfigManager
end

-- ===== INTERNAL MODULE: Core/EffectsManager =====
__onrusha_modules["Core/EffectsManager"] = function()
local TweenService = game:GetService("TweenService")
local EffectsManager = {}
EffectsManager.__index = EffectsManager

function EffectsManager.new(layer, theme, reducedMotion)
    local self = setmetatable({ Layer = layer, Theme = theme, Mode = "None", Density = 8, Speed = 1, Opacity = 0.74, Color = nil, _items = {}, _generation = 0, _destroyed = false, _reducedMotion = reducedMotion == true }, EffectsManager)
    self._themeConnection = theme.Changed.Event:Connect(function() self:_recolor() end)
    return self
end

function EffectsManager:_recolor()
    for _, item in ipairs(self._items) do
        if item.Instance and item.Instance.Parent then
            item.Instance.BackgroundColor3 = self.Color or self.Theme:Get().Accent
        end
    end
end

function EffectsManager:_clear()
    self._generation += 1
    for _, item in ipairs(self._items) do
        if item.Tween then pcall(function() item.Tween:Cancel() end) end
        if item.Instance then item.Instance:Destroy() end
    end
    table.clear(self._items)
end

function EffectsManager:_spawnOne(index, generation)
    if self._destroyed or generation ~= self._generation or self.Mode == "None" or not self.Layer.Parent then return end
    local mode = self.Mode
    local isLine = mode == "Rain"
    local isSnow = mode == "Snow"
    local isGlow = mode == "AmbientGlow"
    local isPulse = mode == "Pulse"
    local size = isGlow and Vector2.new(math.random(70, 120), math.random(70, 120)) or (isPulse and Vector2.new(18, 18) or (isLine and Vector2.new(1, math.random(12, 27)) or (isSnow and Vector2.new(math.random(2, 4), math.random(2, 4)) or Vector2.new(math.random(2, 3), math.random(2, 3)))))
    local item = self._items[index]
    if not item then
        local frame = Instance.new("Frame")
        frame.Name = "AmbientParticle"
        frame.BorderSizePixel = 0
        frame.AnchorPoint = Vector2.new(0.5, 0.5)
        frame.ZIndex = 1
        frame.Parent = self.Layer
        item = { Instance = frame }
        self._items[index] = item
    end
    local frame = item.Instance
    if not frame or not frame.Parent then return end
    frame.Size = UDim2.fromOffset(size.X, size.Y)
    frame.BackgroundColor3 = self.Color or self.Theme:Get().Accent
    frame.BackgroundTransparency = math.clamp(self.Opacity + (math.random() * 0.16), 0.1, 0.96)
    frame.Rotation = isLine and 8 or (mode == "Starfall" and 45 or 0)
    local width = math.max(120, self.Layer.AbsoluteSize.X)
    local height = math.max(100, self.Layer.AbsoluteSize.Y)
    local startX = math.random(8, math.max(9, width - 8))
    local startY = math.random(-height, -8)
    local effectX, effectY = startX, startY
    if mode == "Aurora" then
        frame.Size = UDim2.new(0, math.random(100, 220), 0, math.random(22, 54))
        frame.BackgroundTransparency = 0.94
        frame.Rotation = math.random(-25, 25)
        local gradient = frame:FindFirstChildOfClass("UIGradient") or Instance.new("UIGradient")
        gradient.Rotation = math.random(0, 360)
        gradient.Parent = frame
        effectX = math.random(-30, math.max(20, width - 20))
        effectY = math.random(0, math.max(1, height))
        frame.Position = UDim2.fromOffset(effectX, effectY)
    elseif isGlow then
        frame.Size = UDim2.fromOffset(size.X, size.Y)
        frame.BackgroundTransparency = 0.91
        frame.Rotation = math.random(-20, 20)
        local round = frame:FindFirstChildOfClass("UICorner") or Instance.new("UICorner")
        round.CornerRadius = UDim.new(1, 0)
        round.Parent = frame
        local gradient = frame:FindFirstChildOfClass("UIGradient") or Instance.new("UIGradient")
        gradient.Rotation = math.random(0, 360)
        gradient.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.35), NumberSequenceKeypoint.new(1, 1) })
        gradient.Parent = frame
        effectX = math.random(8, math.max(9, width - 8))
        effectY = math.random(0, math.max(1, height))
        frame.Position = UDim2.fromOffset(effectX, effectY)
    elseif isPulse then
        frame.Size = UDim2.fromOffset(18, 18)
        frame.BackgroundTransparency = 0.84
        frame.Position = UDim2.fromOffset(math.random(12, math.max(13, width - 12)), math.random(12, math.max(13, height - 12)))
        local round = frame:FindFirstChildOfClass("UICorner") or Instance.new("UICorner")
        round.CornerRadius = UDim.new(1, 0)
        round.Parent = frame
        local gradient = frame:FindFirstChildOfClass("UIGradient")
        if gradient then gradient:Destroy() end
    else
        frame.Position = UDim2.fromOffset(startX, startY)
        local round = frame:FindFirstChildOfClass("UICorner")
        if round then round:Destroy() end
        local gradient = frame:FindFirstChildOfClass("UIGradient")
        if gradient then gradient:Destroy() end
    end
    local destination = (mode == "Aurora" or isGlow) and UDim2.fromOffset(effectX + math.random(-18, 18), effectY + math.random(-14, 14)) or (isPulse and frame.Position or UDim2.fromOffset(startX + math.random(-18, 18), height + 12))
    local duration = (isPulse and math.random(24, 42) / 10 or mode == "Rain" and math.random(18, 35) / 10 or math.random(35, 75) / 10) / math.max(0.25, self.Speed)
    local transparency = (mode == "Aurora" or isGlow) and 0.94 or isPulse and 1 or math.clamp(self.Opacity + 0.18, 0.1, 0.98)
    local goal = { Position = destination, BackgroundTransparency = transparency }
    if isPulse then goal.Size = UDim2.fromOffset(math.random(62, 88), math.random(62, 88)) end
    local tween = TweenService:Create(frame, TweenInfo.new(duration, isPulse and Enum.EasingStyle.Sine or Enum.EasingStyle.Linear, Enum.EasingDirection.Out), goal)
    item.Tween = tween
    local completedConnection
    completedConnection = tween.Completed:Connect(function()
        if completedConnection then completedConnection:Disconnect() end
        if self._destroyed or generation ~= self._generation or self.Mode == "None" then return end
        local targetCount = math.clamp(self.Density, 1, 18)
        if self.Mode == "Aurora" then targetCount = math.min(3, targetCount) elseif self.Mode == "AmbientGlow" then targetCount = math.min(4, targetCount) elseif self.Mode == "Pulse" then targetCount = math.min(5, targetCount) end
        if index > targetCount then return end
        task.defer(function() self:_spawnOne(index, generation) end)
    end)
    tween:Play()
end

function EffectsManager:Set(mode)
    mode = tostring(mode or "None")
    local allowed = { Starfall = true, Particles = true, Aurora = true, AmbientGlow = true, Pulse = true, Rain = true, Snow = true, None = true }
    if not allowed[mode] then return false, "Unknown background effect" end
    self:_clear()
    self.Mode = mode
    if mode == "None" or self._reducedMotion then return true end
    local count = math.clamp(self.Density, 1, 18)
    if mode == "Aurora" then count = math.min(3, count) elseif mode == "AmbientGlow" then count = math.min(4, count) elseif mode == "Pulse" then count = math.min(5, count) end
    local generation = self._generation
    for i = 1, count do self:_spawnOne(i, generation) end
    return true
end

function EffectsManager:SetDensity(value)
    local nextDensity = math.clamp(math.floor(tonumber(value) or 8), 1, 18)
    if nextDensity == self.Density then return true end
    self.Density = nextDensity
    if self.Mode == "None" or self._reducedMotion then return true end
    local target = self.Mode == "Aurora" and math.min(3, nextDensity) or self.Mode == "AmbientGlow" and math.min(4, nextDensity) or self.Mode == "Pulse" and math.min(5, nextDensity) or nextDensity
    local current = #self._items
    if target < current then
        for i = current, target + 1, -1 do
            local item = self._items[i]
            if item then
                if item.Tween then item.Tween:Cancel() end
                if item.Instance then item.Instance:Destroy() end
                self._items[i] = nil
            end
        end
    elseif target > current then
        for i = current + 1, target do self:_spawnOne(i, self._generation) end
    end
    return true
end
function EffectsManager:SetColor(value)
    if value ~= nil and typeof(value) ~= "Color3" then return false, "Effect color must be a Color3" end
    self.Color = value
    self:_recolor()
    return true
end
function EffectsManager:SetSpeed(value)
    self.Speed = math.clamp(tonumber(value) or 1, 0.25, 2.5)
    return true
end
function EffectsManager:SetOpacity(value)
    self.Opacity = math.clamp(tonumber(value) or 0.74, 0.1, 0.96)
    for _, item in ipairs(self._items) do if item.Instance then item.Instance.BackgroundTransparency = self.Opacity end end
    return true
end
function EffectsManager:SetReducedMotion(value)
    self._reducedMotion = value == true
    return self:Set(self.Mode)
end
function EffectsManager:Destroy()
    if self._destroyed then return end
    self._destroyed = true
    self:_clear()
    if self._themeConnection then self._themeConnection:Disconnect() end
end
return EffectsManager
end

