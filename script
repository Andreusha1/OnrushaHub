		safeSet(self.ColorCorrection, "Brightness", v.Exposure)
		safeSet(self.ColorCorrection, "Contrast", v.Contrast)
		safeSet(self.ColorCorrection, "Saturation", v.Saturation)
		safeSet(self.ColorCorrection, "TintColor", v.TintColor)
		safeSet(self.Bloom, "Intensity", v.BloomIntensity)
		safeSet(self.Bloom, "Size", v.BloomSize)
