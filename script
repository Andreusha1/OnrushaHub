-- Item class
local Item = {}
Item.__index = Item

function Item:AddCode(callback)
    if callback ~= nil and typeof(callback) ~= "function" then
        error("AddCode expects a function", 2)
    end
    self.Callback = callback
    if self.Value ~= nil and callback then
        safeCall(callback, self.Value)
    end
    return self
end

function Item:SetCallback(callback) return self:AddCode(callback) end
function Item:OnChanged(callback) return self:AddCode(callback) end
function Item:GetValue() return self.Value end
function Item:Get() return self:GetValue() end

function Item:SetValue(value, silent)
    if self.Type == "Toggle" then
        self:_set(value == true, silent)
    elseif self.Type == "Slider" then
        self:_set(value, silent)
    elseif self.Type == "Textbox" then
        self:_set(value, silent)
    elseif self.Type == "Dropdown" then
        self:_set(value, silent)
    end
    return self
end
function Item:Set(value) return self:SetValue(value) end

function Item:SetText(text)
    if self.Title then self.Title.Text = tostring(text) end
    return self
end
function Item:SetName(text) return self:SetText(text) end

function Item:SetVisible(value)
    if self.Card then self.Card.Visible = value == true end
    return self
end
function Item:Show() return self:SetVisible(true) end
function Item:Hide() return self:SetVisible(false) end

function Item:Destroy()
    if self.Card then self.Card:Destroy() end
    if self.Tab and self.Tab.Items then
        for i = #self.Tab.Items, 1, -1 do
            if self.Tab.Items[i] == self then
                table.remove(self.Tab.Items, i)
                break
            end
        end
    end
end

function Item:Enable() return self:SetValue(true) end
function Item:Disable() return self:SetValue(false) end

-- Toggle
local Toggle = setmetatable({}, Item)
Toggle.__index = Toggle

function Toggle:_set(value, silent)
    value = value == true
    self.Value = value
    if self.Button then
        local target = value and UDim2.new(1, -23, 0.5, -10) or UDim2.new(0.58333, -23, 0.5, -10)
        local color = value and Library.ActiveTheme.ToggleOn or Library.ActiveTheme.ToggleOff
        tween(self.Button, {BackgroundColor3 = color}, 0.12)
        tween(self.Knob, {Position = target}, 0.12)
    end
    if not silent then safeCall(self.Callback, value) end
end

-- Slider
local Slider = setmetatable({}, Item)
Slider.__index = Slider

function Slider:_set(value, silent)
    value = math.clamp(tonumber(value) or self.Min, self.Min, self.Max)
    if self.Integer then value = math.floor(value + 0.5) end
    self.Value = value
    if self.ValueText then self.ValueText.Text = tostring(value) end
    if self.Fill and self.Bar then
        local percent = math.clamp((value - self.Min) / math.max(self.Max - self.Min, 0.001), 0, 1)
        tween(self.Fill, {Size = UDim2.new(percent, 0, 1, 0)}, 0.1)
    end
    if not silent then safeCall(self.Callback, value) end
end

function Slider:_fromX(x)
    if not self.Bar then return end
    local left = self.Bar.AbsolutePosition.X
    local width = math.max(self.Bar.AbsoluteSize.X, 1)
    local offset = math.clamp(x - left, 0, width)
    local value = self.Min + (self.Max - self.Min) * (offset / width)
    self:_set(value, false)
end

-- Button
local Button = setmetatable({}, Item)
Button.__index = Button

-- Textbox
local Textbox = setmetatable({}, Item)
Textbox.__index = Textbox

function Textbox:_set(value, silent)
    self.Value = tostring(value or "")
    if self.Box then self.Box.Text = self.Value end
    if not silent then safeCall(self.Callback, self.Value) end
end

-- Dropdown
local Dropdown = setmetatable({}, Item)
Dropdown.__index = Dropdown

function Dropdown:_set(value, silent)
    if type(value) == "table" then
        self.Value = value[1] or ""
    else
        self.Value = value or ""
    end
    if self.Current then self.Current.Text = tostring(self.Value) end
    if not silent then safeCall(self.Callback, value) end
end

function Dropdown:Refresh(values)
    self.Values = values or {}
    self.Index = 1
    self:_set(self.Values[1] or "", true)
end

function Dropdown:Next()
    if #self.Values == 0 then return end
    self.Index = self.Index % #self.Values + 1
    self:_set(self.Values[self.Index], false)
end

function Dropdown:Previous()
    if #self.Values == 0 then return end
    self.Index = (self.Index - 2) % #self.Values + 1
    self:_set(self.Values[self.Index], false)
end

