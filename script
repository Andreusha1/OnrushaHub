-- Tab methods are deliberately lazy: they only create the requested item.
function Library:_installTabMethods(tab)
	if tab._methodsInstalled then
		return tab
	end
	tab._methodsInstalled = true

	function tab:AddToggle(name, default, callback)
		return self.Window:_add(self, "Toggle", {
			Name = name,
			Default = default == true,
		}, callback)
	end

	function tab:AddSlider(name, min, max, default, callback)
		local options
		if type(min) == "table" then
			options = min
			options.Name = name
			callback = max
		else
			options = {
				Name = name,
				Min = min,
				Max = max,
				Default = default,
			}
		end
		return self.Window:_add(self, "Slider", options, callback)
	end

	function tab:AddButton(name, callback)
		return self.Window:_add(self, "Button", {
			Name = name,
		}, callback)
	end

	function tab:AddTextbox(name, default, callback)
		return self.Window:_add(self, "Textbox", {
			Name = name,
			Default = default,
		}, callback)
	end

	function tab:AddDropdown(name, values, default, callback)
		return self.Window:_add(self, "Dropdown", {
			Name = name,
			Values = values or {},
			Default = default,
		}, callback)
	end

	function tab:AddLabel(text)
		return self.Window:_add(self, "Label", {
			Text = text,
		})
	end

	function tab:AddSection(text)
		return self.Window:_add(self, "Section", {
			Text = text,
		})
	end

	function tab:AddKeybind(name, default, callback)
		return self.Window:_add(self, "Keybind", {
			Name = name,
			Default = default,
		}, callback)
	end

	function tab:Clear()
		for _, item in ipairs(self.Items) do
			if item.Card and item.Card.Parent then
				item.Card:Destroy()
			end
		end
		table.clear(self.Items)
		return self
	end

	return tab
end

-- Patch tab creation so every tab has the same API, without adding UI.
local oldMakeTab = Library._makeTab
function Library:_makeTab(name, button, content)
	local tab = oldMakeTab(self, name, button, content)
	tab.Window = self
	self:_installTabMethods(tab)
	return tab
end

-- Make item APIs consistent and safe.
local oldAddCode = Item.AddCode
function Item:AddCode(callback)
	if callback ~= nil and typeof(callback) ~= "function" then
		error("AddCode expects a function", 2)
	end
	self.Callback = callback
	return self
end

function Item:RemoveCode()
	self.Callback = nil
	return self
end

function Item:IsVisible()
	return self.Card and self.Card.Visible == true
end

function Item:SetVisible(value)
	if self.Card then
		self.Card.Visible = value == true
	end
	return self
end


function Library:IsOpen()
	return not self.Destroyed and G2L["2"] and G2L["2"].Visible == true
end

function Library:SetVisible(value)
	if value then
		return self:Open()
	end
	return self:Close()
end

function Library:GetTab(name)
	return self.Tabs[name]
end

function Library:GetActiveTab()
	return self.ActiveTab
end

function Library:EachTab(callback)
	if typeof(callback) ~= "function" then
		return self
	end
	for name, tab in pairs(self.Tabs) do
		pcall(callback, tab, name)
	end
	return self
end

function Library:EachItem(callback)
	if typeof(callback) ~= "function" then
		return self
	end
	for _, tab in pairs(self.Tabs) do
		for _, item in ipairs(tab.Items) do
			pcall(callback, item, tab)
		end
	end
	return self
end

