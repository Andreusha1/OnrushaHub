            play(ctx, fill, 0.15, { Size = UDim2.fromScale(p, 1) })
        end
        component:Set(options.Default or 0, true)
    end

    if not isVisualOnly then
        local settingsButton = make("TextButton", { Name = "SettingsButton", BackgroundTransparency = 1, Text = "v", Font = Enum.Font.GothamMedium, TextSize = 15, Size = UDim2.fromOffset(20, 24), Position = UDim2.new(1, -22, 0, 0), Visible = false, AutoButtonColor = false }, top)
        ctx.Theme:Bind(settingsButton, { TextColor3 = "SecondaryText" })
        component._settingsButton = settingsButton
        component.Title = title
    end

    local function makeSmallButton(label, size, position)
        local button = make("TextButton", { Text = label, Font = Enum.Font.GothamBold, TextSize = 12, Size = size, Position = position or UDim2.new(), BorderSizePixel = 0, AutoButtonColor = false }, controlParent)
        ctx.Theme:Bind(button, { BackgroundColor3 = "Hover", TextColor3 = "Text" })
