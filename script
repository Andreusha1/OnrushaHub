-- New item factory
function Library:_newItem(tab, kind, options)
    options = options or {}
    local parent = tab.Content

    if kind == "Toggle" then
        local card = makeCard(parent, options.Name or "Toggle")
        local title = makeTitle(card, options.Name or "Toggle")

        local button = Instance.new("TextButton")
        button.AutoButtonColor = false
        button.BorderSizePixel = 0
        button.BackgroundColor3 = Library.ActiveTheme.ToggleOff
        button.Size = UDim2.new(0, 48, 0, 26)
        button.Position = UDim2.new(1, -65, 0.5, -13)
        button.Text = ""
        button.Parent = card
        makeCorner(button, 100)

        local knob = Instance.new("Frame")
        knob.BorderSizePixel = 0
        knob.BackgroundColor3 = Color3.fromRGB(230, 227, 249)
        knob.Size = UDim2.new(0, 20, 0, 20)
        knob.Position = UDim2.new(0.58333, -23, 0.5, -10)
        knob.Parent = button
        makeCorner(knob, 100)

        local item = setmetatable({
            Type = "Toggle", Card = card, Title = title,
            Button = button, Knob = knob,
            Value = options.Default == true,
        }, Toggle)

        button.MouseButton1Click:Connect(function()
            item:_set(not item.Value, false)
        end)

        item:_set(item.Value, true)
        return item
    end

    if kind == "Slider" then
        local card = makeCard(parent, options.Name or "Slider")
        local title = makeTitle(card, options.Name or "Slider")
        local min = tonumber(options.Min) or 0
        local max = tonumber(options.Max) or 100
        local default = tonumber(options.Default) or min

        local bar = Instance.new("Frame")
        bar.Name = "bar"
        bar.BackgroundColor3 = Color3.fromRGB(52, 50, 81)
        bar.BorderSizePixel = 0
        bar.AnchorPoint = Vector2.new(0.5, 0.5)
        bar.Size = UDim2.new(0, 199, 0, 25)
        bar.Position = UDim2.new(0.63, 0, 0.504, 0)
