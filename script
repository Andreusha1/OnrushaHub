function Item:SetName(text)
	if self.Title then
		self.Title.Text = tostring(text)
	end
	self.Name = tostring(text)
	return self
end

function Item:SetDescription(text)
	local description = self.Card and self.Card:FindFirstChild("function description")
	if not description then
		description = makeDescription(self.Card, text)
	else
		description.Text = tostring(text or "")
	end
	return self
end

function Item:SetDisabled(value)
	self.Disabled = value == true
	if self.Button and self.Button:IsA("GuiButton") then
		self.Button.Active = not self.Disabled
		self.Button.AutoButtonColor = not self.Disabled
	end
	return self
end

function Item:IsDisabled()
	return self.Disabled == true
end

function Item:Reset()
	if self.Type == "Toggle" then
		self:SetValue(self.Default == true)
	elseif self.Type == "Slider" then
		self:SetValue(self.Default)
	elseif self.Type == "Textbox" then
		self:SetValue(self.Default or "")
	elseif self.Type == "Dropdown" then
		self:SetValue(self.Default or self.Options[1])
	elseif self.Type == "Keybind" then
		self:SetValue(self.Default)
	end
	return self
end

function Item:Destroy()
	if self.Card then
		self.Card:Destroy()
	end
	if self.Tab and self.Tab.Items then
		for i = #self.Tab.Items, 1, -1 do
			if self.Tab.Items[i] == self then
				table.remove(self.Tab.Items, i)
				break
			end
		end
	end
	return self
end

function Item:Show()
	return self:SetVisible(true)
end

function Item:Hide()
	return self:SetVisible(false)
end

function Item:Toggle()
	if self.Type == "Toggle" then
		return self:SetValue(not self:GetValue())
	end
	return self
end

function Item:Fire(value)
	if typeof(self.Callback) == "function" then
		task.spawn(function()
			pcall(self.Callback, value ~= nil and value or self:GetValue())
		end)
	end
	return self
end


return Library
