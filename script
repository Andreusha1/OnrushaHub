	local function applyBindingGradient(self, binding)
		local instance = binding and binding.Instance
		if not instance or not instance.Parent or not instance:IsA("GuiObject") then return end
		if instance.AbsoluteSize.X < 34 or instance.AbsoluteSize.Y < 14 then
			local tinyGradient = instance:FindFirstChild("OnrushaThemeGradient")
			if tinyGradient then tinyGradient:Destroy() end
			return
		end
		local token = binding.Properties and binding.Properties.BackgroundColor3
		local preset = self._gradients and self._gradients[self._name]
		local colors = type(token) == "string" and preset and preset.Tokens[token]
		local gradient = instance:FindFirstChild("OnrushaThemeGradient")
		if colors then
			local existing = instance:FindFirstChildOfClass("UIGradient")
			if existing and existing ~= gradient then
				gradient = existing
				gradient.Name = "OnrushaThemeGradient"
			end
			if not gradient then
				gradient = Instance.new("UIGradient")
				gradient.Name = "OnrushaThemeGradient"
				gradient.Parent = instance
			end
			instance.BackgroundColor3 = Color3.new(1, 1, 1)
			gradient.Color = colors
			gradient.Rotation = preset.Rotation or 0
		else
			if gradient then gradient:Destroy() end
		end
	end

