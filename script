	local function themedText(parent, theme, text, size, token, bold)
		local label = make("TextLabel", { BackgroundTransparency = 1, Text = text or "", Font = bold and Enum.Font.GothamBold or Enum.Font.GothamMedium, TextSize = (size or 13) + ((size or 13) >= 11 and 2 or 0), TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Center, TextTruncate = Enum.TextTruncate.AtEnd }, parent)
		theme:Bind(label, { TextColor3 = token or "Text" })
		return label
	end
	local function tween(ctx, object, duration, properties)
		if not ctx.Settings.AnimationsEnabled or ctx.Settings.ReducedMotion then
			for key, value in pairs(properties) do object[key] = value end
			return nil
		end
		local current = ctx._activeTweens[object]
		if current then pcall(function() current:Cancel() end) end
		local info = TweenInfo.new(duration / math.max(0.2, ctx.Settings.AnimationSpeed or 1), Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
		local nextTween = TweenService:Create(object, info, properties)
		ctx._activeTweens[object] = nextTween
		nextTween.Completed:Connect(function() if ctx._activeTweens[object] == nextTween then ctx._activeTweens[object] = nil end end)
		nextTween:Play()
		return nextTween
	end

	local function safeIcon(icon, name)
		icon = tostring(icon or "")
		if icon == "" then return "" end
		if #icon <= 2 and string.match(icon, "^[%w%p ]+$") then return icon end
		local first = string.match(tostring(name or ""), "[A-Za-z0-9]")
		if first then return first:upper() end
		return "*"
	end

