local function safeCall(callback, ...)
	if typeof(callback) ~= "function" then
		return
	end
	task.spawn(function(...)
		local ok, err = pcall(callback, ...)
		if not ok then
			warn("[onrushagui] " .. tostring(err))
		end
	end, ...)
end

local function tween(instance, properties, time)
