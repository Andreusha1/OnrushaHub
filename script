local function safeCall(callback, ...)
    if typeof(callback) ~= "function" then return end
    task.spawn(function(...)
        local ok, err = pcall(callback, ...)
        if not ok then warn("[onrushagui] " .. tostring(err)) end
    end, ...)
end

local function tween(instance, properties, time)
    return TweenService:Create(instance, TweenInfo.new(time or 0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), properties):Play()
end

local function makeCorner(parent, radius)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, radius or 15)
    c.Parent = parent
    return c
end

local function makeStroke(parent, color, thickness)
    local s = Instance.new("UIStroke")
    s.Color = color or Library.ActiveTheme.Stroke
    s.Thickness = thickness or 1.7
    s.Parent = parent
    return s
end

