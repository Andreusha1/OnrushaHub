		if self._destroyed then return end
		if self.Enabled then
			self:_applyLighting()
			self:_applyValues()
			self.ColorCorrection.Enabled = true
			self.ColorCorrection.Parent = Lighting
			self.Bloom.Enabled = self.Values.BloomEnabled
			self.Bloom.Parent = self.Values.BloomEnabled and Lighting or nil
			self.SunRays.Enabled = self.Values.SunRaysEnabled
			self.SunRays.Parent = self.Values.SunRaysEnabled and Lighting or nil
			self.DepthOfField.Enabled = self.Values.DepthOfFieldEnabled
			self.DepthOfField.Parent = self.Values.DepthOfFieldEnabled and Lighting or nil
		else
			self.ColorCorrection.Parent = nil
			self.Bloom.Parent = nil
			self.SunRays.Parent = nil
			self.DepthOfField.Parent = nil
			self:_restoreLighting()
