-- Tab methods
function Library:_makeTab(name, button, content)
    local tab = {
        Name = name, Button = button, Content = content,
        Items = {}, Window = self,
    }

    function tab:AddToggle(itemName, default, callback)
        local item = self.Window:_newItem(self, "Toggle", {Name = itemName, Default = default})
        if callback then item:AddCode(callback) end
        table.insert(self.Items, item)
        return item
    end

    function tab:AddSlider(itemName, min, max, default, callback)
        local item = self.Window:_newItem(self, "Slider", {Name = itemName, Min = min, Max = max, Default = default})
        if callback then item:AddCode(callback) end
        table.insert(self.Items, item)
        return item
    end

    function tab:AddButton(itemName, callback)
        local item = self.Window:_newItem(self, "Button", {Name = itemName})
        if callback then item:AddCode(callback) end
        table.insert(self.Items, item)
        return item
    end

    function tab:AddTextbox(itemName, default, callback)
        local item = self.Window:_newItem(self, "Textbox", {Name = itemName, Default = default})
        if callback then item:AddCode(callback) end
        table.insert(self.Items, item)
        return item
    end

    function tab:AddDropdown(itemName, values, default, callback)
        local item = self.Window:_newItem(self, "Dropdown", {Name = itemName, Values = values, Default = default})
        if callback then item:AddCode(callback) end
        table.insert(self.Items, item)
        return item
    end

    function tab:AddLabel(text)
        local item = self.Window:_newItem(self, "Label", {Text = text})
        table.insert(self.Items, item)
        return item
    end

    function tab:AddSection(text)
        local item = self.Window:_newItem(self, "Section", {Text = text})
        table.insert(self.Items, item)
        return item
    end

    function tab:Clear()
        for _, item in ipairs(self.Items) do
            if item.Card then item.Card:Destroy() end
        end
        table.clear(self.Items)
    end

    return tab
end

function Library:_selectTab(tab)
    self.ActiveTab = tab
    for _, t in pairs(self.Tabs) do
        local selected = t == tab
        if t.Scrolling then t.Scrolling.Visible = selected end
        if t.Button then
            if selected then
                t.Button.BackgroundColor3 = Color3.fromRGB(208, 167, 255)
                t.Button.TextColor3 = Color3.fromRGB(232, 147, 255)
            else
                t.Button.BackgroundColor3 = Color3.fromRGB(99, 99, 99)
                t.Button.TextColor3 = Color3.fromRGB(190, 190, 190)
            end
        end
    end
end

function Library:CreateTab(name)
    name = tostring(name or ("Tab" .. tostring(#self.Tabs + 1)))
    if self.Tabs[name] then return self.Tabs[name] end

    local button = Instance.new("TextButton")
    button.Name = name
    button.Text = name
    button.TextWrapped = true
    button.TextSize = 14
    button.TextColor3 = Color3.fromRGB(190, 190, 190)
    button.BackgroundColor3 = Color3.fromRGB(99, 99, 99)
    button.BackgroundTransparency = 0.65
    button.FontFace = Font.new("rbxassetid://12187365364", Enum.FontWeight.Normal)
    button.Size = UDim2.new(0, 83, 0, 32)
    button.Parent = G2L["13"]
    makeCorner(button, 8)
    makeStroke(button, Color3.fromRGB(128, 128, 128), 1)

    local scrolling = Instance.new("ScrollingFrame")
    scrolling.Name = "functions_" .. name
    scrolling.Active = true
    scrolling.BackgroundTransparency = 1
    scrolling.BorderSizePixel = 0
    scrolling.Position = UDim2.new(0.5, 0, 0.638, 0)
    scrolling.AnchorPoint = Vector2.new(0.5, 0.5)
    scrolling.Size = UDim2.new(0, 507, 0, 361)
    scrolling.ScrollBarThickness = 0
    scrolling.AutomaticCanvasSize = Enum.AutomaticSize.Y
    scrolling.Visible = false
    scrolling.Parent = G2L["2"]

    local content = Instance.new("Frame")
    content.Name = "content"
    content.BackgroundTransparency = 1
    content.BorderSizePixel = 0
    content.Size = UDim2.new(1, 0, 0, 0)
    content.AutomaticSize = Enum.AutomaticSize.Y
    content.Parent = scrolling

    local layout = Instance.new("UIListLayout", content)
    layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
    layout.Padding = UDim.new(0.04, 0)
    layout.SortOrder = Enum.SortOrder.LayoutOrder

    local tab = self:_makeTab(name, button, content)
    tab.Scrolling = scrolling
    self.Tabs[name] = tab

    button.MouseButton1Click:Connect(function() self:_selectTab(tab) end)
    return tab
end

function Library:GetTab(name) return self.Tabs[name] end
function Library:SelectTab(name)
    local tab = self.Tabs[name]
    if tab then self:_selectTab(tab) end
end

function Library:Open()
    G2L["2"].Visible = true
end

function Library:Close()
    G2L["2"].Visible = false
end

function Library:Toggle()
    G2L["2"].Visible = not G2L["2"].Visible
end

function Library:Destroy()
    if G2L["1"] then G2L["1"]:Destroy() end
end

function Library:SetTitle(text)
    G2L["b"].Text = tostring(text)
end
Library.SetGameName = Library.SetTitle

function Library:SetTheme(themeName)
    if type(themeName) == "string" and Library.Theme[themeName] then
        Library.ActiveTheme = Library.Theme[themeName]
    elseif type(themeName) == "table" then
        Library.ActiveTheme = themeName
    end

    local t = Library.ActiveTheme
    G2L["2"].BackgroundColor3 = t.Background
    G2L["5"].BackgroundColor3 = t.Topbar

    for _, tab in pairs(self.Tabs) do
        for _, item in ipairs(tab.Items) do
            if item.Card then
                item.Card.BackgroundColor3 = t.Element
            end
        end
    end
end

function Library.create(options)
    options = options or {}
    local window = setmetatable({
        Gui = G2L["1"],
        Frame = G2L["2"],
        Tabs = {},
        Items = {},
    }, Library)

    if options.Name then G2L["1"].Name = options.Name end
    if options.Title then G2L["b"].Text = options.Title end
    if options.Theme then window:SetTheme(options.Theme) end

    G2L["c"].MouseButton1Click:Connect(function() window:Destroy() end)
    G2L["f"].MouseButton1Click:Connect(function() window:Close() end)

    -- Создаём дефолтные вкладки
    local mainTab = window:CreateTab("Main")
    local playerTab = window:CreateTab("Player")
    window:_selectTab(mainTab)

    return window
end

return Library
