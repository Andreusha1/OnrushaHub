function Library.create(options)
	options = options or {}
	local dragEnabled = options.Drag == true
	local openButtonDragEnabled = options.OpenButtonDrag == true
	local window = setmetatable({
		Gui = G2L["1"],
		Frame = G2L["2"],
		Tabs = {},
		Items = {},
		Connections = {},
		Destroyed = false,
	}, Library)

	G2L["1"].Name = options.Name or "onrushanewgui"
	G2L["2"].Visible = true
	G2L["4e"].Visible = false

	local function connect(signal, callback)
		local connection = signal:Connect(callback)
		table.insert(window.Connections, connection)
		return connection
	end

	local function makeExistingTab(name, button, scrolling, content)
		local tab = window:_makeTab(name, button, content)
		tab.Scrolling = scrolling
		tab.Content = content
		window.Tabs[name] = tab
		return tab
	end

	-- Keep the original interface, but remove the three example/function cards from the template.
	-- They are only design placeholders and should not appear when create() is called.
	for _, object in ipairs({G2L["27"], G2L["31"], G2L["3c"]}) do
		if object then
			object:Destroy()
		end
	end

	local mainTab = makeExistingTab("Main", G2L["14"], G2L["25"], G2L["26"])

	-- Player gets an empty container. Nothing is added until the user adds it.
	local playerScrolling, playerContent = makeContainer(G2L["2"])
	playerScrolling.Visible = false
	local playerTab = makeExistingTab("Player", G2L["1c"], playerScrolling, playerContent)

	connect(G2L["14"].MouseButton1Click, function()
		window:_selectTab(mainTab)
	end)

	connect(G2L["1c"].MouseButton1Click, function()
		window:_selectTab(playerTab)
	end)

	connect(G2L["f"].MouseButton1Click, function()
		window:Close()
	end)

	connect(G2L["4e"].MouseButton1Click, function()
		if not openButtonDragEnabled then
			window:Open()
			return
		end

		window:Open()
	end)

	if dragEnabled then
		local dragging = false
		local dragStart
		local startPosition

		connect(G2L["5"].InputBegan, function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				dragging = true
				dragStart = input.Position
				startPosition = G2L["2"].Position
			end
		end)

		connect(G2L["5"].InputEnded, function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				dragging = false
			end
		end)

		connect(UserInputService.InputChanged, function(input)
			if not dragging then
				return
			end

			if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
				local delta = input.Position - dragStart

				G2L["2"].Position = UDim2.new(
					startPosition.X.Scale,
					startPosition.X.Offset + delta.X,
					startPosition.Y.Scale,
					startPosition.Y.Offset + delta.Y
				)
			end
		end)
	end
	
	connect(G2L["c"].MouseButton1Click, function()
		window:Destroy()
	end)

	window:_selectTab(mainTab)

	if options.Open == false then
		window:Close()
	end

	if openButtonDragEnabled then
		local dragging = false
		local dragStart
		local startPosition
		local moved = false

		connect(G2L["4e"].InputBegan, function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				dragging = true
				moved = false
				dragStart = input.Position
				startPosition = G2L["4e"].Position
			end
		end)

		connect(UserInputService.InputChanged, function(input)
			if not dragging then
				return
			end

			if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
				local delta = input.Position - dragStart

				if math.abs(delta.X) > 3 or math.abs(delta.Y) > 3 then
					moved = true
				end

				G2L["4e"].Position = UDim2.new(
					startPosition.X.Scale,
					startPosition.X.Offset + delta.X,
					startPosition.Y.Scale,
					startPosition.Y.Offset + delta.Y
				)
			end
		end)

		connect(UserInputService.InputEnded, function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				dragging = false
			end
		end)
	end
	return window
end

function Library:_track(item, tab)
	if not item then
		return nil
	end
	item.Window = self
	item.Tab = tab
	table.insert(tab.Items, item)
	return item
end

function Library:_add(tab, kind, options, callback)
	local item = self:_newItem(tab, kind, options or {})
	self:_track(item, tab)
	if callback then
		item:AddCode(callback)
	end
	return item
end

function Library:_getTab(tab)
	if type(tab) == "table" then
		return tab
	end
	if type(tab) == "string" then
		return self.Tabs[tab]
	end
	return self.ActiveTab
end

function Library:CreateTab(name)
	name = tostring(name or ("Tab" .. tostring(#self.Tabs + 1)))

	if self.Tabs[name] then
		return self.Tabs[name]
	end

	local button = Instance.new("TextButton")
	button.Name = "function type/" .. name
	button.Text = name
	button.TextWrapped = true
	button.TextSize = 14
	button.TextColor3 = Color3.fromRGB(190, 190, 190)
	button.BackgroundColor3 = Color3.fromRGB(99, 99, 99)
	button.BackgroundTransparency = 0.65
	button.FontFace = Font.new("rbxassetid://12187365364", Enum.FontWeight.Regular, Enum.FontStyle.Normal)
	button.Size = UDim2.new(0, 83, 0, 32)
	button.Parent = G2L["13"]
	makeCorner(button, 8)
	makeStroke(button, Color3.fromRGB(128, 128, 128), 1)

	local scrolling, content = makeContainer(G2L["2"])
	scrolling.Visible = false

	local tab = self:_makeTab(name, button, content)
	tab.Scrolling = scrolling
	tab.Content = content
	self.Tabs[name] = tab

	button.MouseButton1Click:Connect(function()
		self:_selectTab(tab)
	end)

	return tab
end

