        valueLabel.AnchorPoint = Vector2.new(1, 0)
        valueLabel.Position = UDim2.new(1, 0, 0, 0)
        valueLabel.Size = UDim2.fromOffset(40, 17)
        local track = make("Frame", { Position = UDim2.new(0, 0, 0, description ~= "" and (25 + descriptionHeight) or 26), Size = UDim2.new(1, 0, 0, 6), BorderSizePixel = 0 }, top)
        ctx.Theme:Bind(track, { BackgroundColor3 = "Hover" }); corner(track, 3)
